{
  "name": "impisitech-nexus", "displayName": "NEXUS by Impisi Tech", "description": "Understand and inspect code locally, directly in VS Code.", "version": "0.1.0", "publisher": "ImpisiTech", "license": "MIT", "icon": "media/icon.png", "engines": {"vscode": "^1.85.0"}, "categories": ["Other", "Education"], "keywords": ["code explanation", "static analysis", "learning"], "main": "./dist/extension.js",
  "activationEvents": ["onView:nexus.sidebar"],
  "contributes": {
    "viewsContainers": {"activitybar": [{"id": "nexus", "title": "NEXUS", "icon": "media/activity.svg"}]},
    "views": {"nexus": [{"type": "webview", "id": "nexus.sidebar", "name": "NEXUS"}]},
    "commands": [
      {"command":"nexus.explainSelection","title":"NEXUS: Explain Selected Code"}, {"command":"nexus.explainFile","title":"NEXUS: Explain Current File"}, {"command":"nexus.explainFunction","title":"NEXUS: Explain Function"}, {"command":"nexus.analyze","title":"NEXUS: Analyze Current File"}, {"command":"nexus.suggestions","title":"NEXUS: Show Code Suggestions"}, {"command":"nexus.flow","title":"NEXUS: Visualize Logic Flow"}, {"command":"nexus.learning","title":"NEXUS: Toggle Learning Mode"}, {"command":"nexus.clear","title":"NEXUS: Clear Results"}, {"command":"nexus.refresh","title":"NEXUS: Refresh Analysis"}
    ],
    "menus": {"editor/context": [{"command":"nexus.explainSelection","when":"editorHasSelection","group":"navigation@90"},{"command":"nexus.explainFunction","group":"navigation@91"},{"command":"nexus.analyze","group":"navigation@92"}]},
    "keybindings": [{"command":"nexus.explainSelection","key":"ctrl+alt+e","mac":"cmd+alt+e","when":"editorTextFocus && editorHasSelection"}]
  },
  "scripts": {"build":"node esbuild.mjs", "watch":"node esbuild.mjs --watch", "check":"tsc --noEmit", "test":"vitest run", "package":"vsce package --no-dependencies --allow-missing-repository"},
  "devDependencies": {"@types/node":"^20.17.0", "@types/vscode":"^1.85.0", "@vscode/vsce":"^3.2.1", "esbuild":"^0.25.0", "typescript":"^5.7.3", "vitest":"^3.0.0"}
}
